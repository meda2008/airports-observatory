{"url":"https://次元.vip/","body":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>次元链接 - CYLINK</title>\n    <style>\n        /* Basic Reset */\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        /* Body Styling */\n        body, html {\n            height: 100%;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            font-family: Arial, sans-serif;\n            background-color: #000000; /* Full black background */\n            overflow: hidden;\n            color: #ffffff; /* White text */\n        }\n        /* Centering Container */\n        .container {\n            text-align: center;\n        }\n        /* Loading Circle Styling */\n        .loader {\n            margin: 0 auto 20px auto;\n            border: 8px solid rgba(255, 255, 255, 0.1); /* Light border */\n            border-top: 8px solid #ffffff; /* White border */\n            border-radius: 50%;\n            width: 80px;\n            height: 80px;\n            animation: spin 1.5s linear infinite;\n        }\n        /* Flashing Text Animation - Subtle Dim */\n        @keyframes flash {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.6; } /* Dim the text, but don't let it disappear */\n        }\n        /* Heading and Text Styling with Flashing */\n        h1, p {\n            font-size: 2em;\n            margin-bottom: 20px;\n            animation: flash 2s infinite; /* Subtle flashing effect */\n        }\n        p {\n            font-size: 18px;\n        }\n        /* Red Color for Countdown */\n        #countdown {\n            font-weight: bold;\n            color: red;\n        }\n        /* Circle Spin Animation */\n        @keyframes spin {\n            0% { transform: rotate(0deg); }\n            100% { transform: rotate(360deg); }\n        }\n        /* Responsive Centering for Small Devices */\n        @media only screen and (max-width: 600px) {\n            h1 {\n                font-size: 1.5em;\n            }\n            p {\n                font-size: 16px;\n            }\n            .loader {\n                width: 60px;\n                height: 60px;\n                border-width: 6px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <!-- Circle Loader -->\n        <div class=\"loader\"></div>\n        <!-- Redirecting Text in Chinese with Subtle Flashing Effect -->\n        <h1>https://次元.vip</h1>\n        <h1>次元链接 - CYLINK</h1>\n        <h1>正在为您规划回家的路......</h1>\n        <p>请耐心等待 <span id=\"countdown\">5</span>秒! 如有拥堵即转接人工...</p>\n    </div>\n\n    <script>\n \n// 加密后的域名\nconst obfuscatedDomains = [\n    \"39mbuk3Yy8yL6MHc0RHa\",\n    \"=4Wdm5iNyc3cusmbpxWej9yL6MHc0RHa\",\n    \"==QZt5CM4c3cusmbpxWej9yL6MHc0RHa\",\n    \"vJHcuMDN082ZusmbpxWej9yL6MHc0RHa\",\n    \"=Umbv5iNy82ZusmbpxWej9yL6MHc0RHa\"\n];\n\n        // Obfuscated Base64 encoded + reversed backup support URL\n        const obfuscatedBackupUrl = \"3EGMkZzMjFjMykjNtgjNlFWL5UjY00iZmdDOtQjZ4QDZ1EWM9QWafVGdpNnYld3PvQWZi1WZvQXYoN2L0FGaj5Cczlmcj5ybn9yL6MHc0RHa\"; \n        // Function to reverse string back\n        function reverseString(str) {\n            return str.split(\"\").reverse().join(\"\");\n        }\n\n        // Function to decode Base64 with error handling\n        function decodeBase64(encodedStr) {\n            try {\n                return atob(encodedStr);\n            } catch (e) {\n                console.error(\"Failed to decode Base64:\", e);\n                return null;\n            }\n        }\n\n        // Function to check and add proper Base64 padding\n        function ensureBase64Padding(str) {\n            const paddingNeeded = 4 - (str.length % 4);\n            if (paddingNeeded !== 4) {\n                str = str + '='.repeat(paddingNeeded); // Add padding '=' to make the length divisible by 4\n            }\n            return str;\n        }\n\n        // Function to decode the obfuscated domains\n        function decodeDomain(obfuscatedDomain) {\n            const reversed = reverseString(obfuscatedDomain);\n            const padded = ensureBase64Padding(reversed); // Ensure proper padding\n            return decodeBase64(padded);\n        }\n\n        // Function to get the current full path and query parameters\n        function getFullPathWithQueryParams() {\n            const path = window.location.pathname;  // Get current path\n            const queryString = window.location.search;  // Get current query string\n            return path + queryString;  // Combine both\n        }\n\n        // Function to test domains using 'no-cors' mode\n        function testDomain(domain) {\n            const testUrl = domain + '/checkWAF.html'; // Append checkWAF.html for bypass\n            console.log(`Testing domain: ${testUrl}`);\n\n            return fetch(testUrl, {\n                method: 'HEAD', // Use HEAD to check only headers\n                mode: 'no-cors', // Use 'no-cors' to bypass CORS issues\n                credentials: 'omit' // Ensure no credentials are sent\n            })\n            .then(() => {\n                // Since we can't read response status in no-cors mode, we assume success\n                const fullPathWithParams = getFullPathWithQueryParams();  // Get full path + query params\n                const redirectUrl = domain + fullPathWithParams;  // Redirect with full path and params\n                console.log(`Redirecting to ${redirectUrl}`);\n                window.location.href = redirectUrl;  // Perform the redirection\n                return true;\n            })\n            .catch(error => {\n                console.error(`Error accessing ${testUrl}:`, error);\n                return false; // Return false if the domain is not accessible\n            });\n        }\n\n        // Function to attempt redirection to obfuscated backup support URL without path or query parameters\n        function redirectToBackup() {\n            const decodedBackupUrl = decodeDomain(obfuscatedBackupUrl);\n            if (!decodedBackupUrl) {\n                console.error(\"Failed to decode backup URL\");\n                return;\n            }\n            console.log(`Redirecting to backup URL: ${decodedBackupUrl}`);\n            window.location.href = decodedBackupUrl; // Redirect to the backup URL without path or query parameters\n        }\n\n        // Countdown function\n        function startCountdown(seconds, callback) {\n            const countdownElement = document.getElementById('countdown');\n            countdownElement.innerText = seconds;\n\n            const interval = setInterval(() => {\n                seconds--;\n                countdownElement.innerText = seconds;\n\n                if (seconds <= 0) {\n                    clearInterval(interval);\n                    callback();\n                }\n            }, 1000);\n        }\n\n        // Loop through the obfuscated domains, decode, and test each one\n        let domainFound = false; // To track if any good domain was found\n        (async function() {\n            // Start the countdown with 5 seconds\n            startCountdown(5, async function() {\n                for (let obfuscatedDomain of obfuscatedDomains) {\n                    const decodedDomain = decodeDomain(obfuscatedDomain);\n                    if (!decodedDomain) {\n                        console.error(`Failed to decode domain: ${obfuscatedDomain}`);\n                        continue;\n                    }\n                    console.log(`Decoded domain: ${decodedDomain}`);\n                    const result = await testDomain(decodedDomain); // Wait for the domain test\n                    if (result) {\n                        domainFound = true; // A good domain was found, stop further tests\n                        break;\n                    }\n                }\n\n                // If no domain was found, redirect to the backup URL without path or query parameters\n                if (!domainFound) {\n                    console.log(\"No accessible domains found. Redirecting to backup...\");\n                    redirectToBackup();\n                }\n            });\n        })();\n    </script>\n</body>\n</html>\n\n","sha256":"c2b794306efb5a6eaa2946e316a480c69f3be4e16fb8f01b0523cac727349d62","observedAt":"2026-11-20T04:47:00.934Z"}