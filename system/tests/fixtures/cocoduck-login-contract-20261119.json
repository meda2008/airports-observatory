{"url":"https://home.cocoduck.co/auth/login","status":200,"observedAt":"2026-11-19T09:23:38.270Z","sha256":"4652958244051d72e812a574e91fd03ba695126229f2afcb89c9a7dfbe2940ef","body":"<!doctype html>\n<html lang=\"zh\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"robots\" content=\"noindex\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n    <meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0\" name=\"viewport\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"ie=edge\" />\n    <title>COCODUCK</title>\n    <!-- Google tag (gtag.js) -->\n        <!-- CSS files -->\n    <link href=\"//testingcf.jsdelivr.net/npm/@tabler/core@latest/dist/css/tabler.min.css\" rel=\"stylesheet\" />\n    <link href=\"//testingcf.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" rel=\"stylesheet\" />\n    <!-- JS files -->\n    <script src=\"/assets/js/fuck.min.js\"></script>\n    <script src=\"//testingcf.jsdelivr.net/npm/jquery/dist/jquery.min.js\"></script>\n    <script src=\"//testingcf.jsdelivr.net/npm/@tabler/core@latest/dist/js/tabler.min.js\"></script>\n    <script src=\"/assets/js/bootstrap-jquery-modal-compat.js\"></script>\n</head>\n<body class=\"border-top-wide border-primary d-flex flex-column\">\n    <div class=\"page page-center\">\n        <div class=\"container-tight my-auto\">\n            <div class=\"text-center mb-4\">\n                <a href=\"#\" class=\"navbar-brand navbar-brand-autodark\">\n                    <img src=\"/images/uim-logo-round_96x96.png\" loading=\"lazy\" height=\"64\" alt=\"SSPanel-UIM Logo\">\n                </a>\n            </div>\n            <div class=\"card card-md\">\n                <div class=\"card-body\">\n                    <h2 class=\"card-title text-center mb-4\">\u767b\u5f55\u5230\u7528\u6237\u4e2d\u5fc3</h2>\n                    <div class=\"mb-3\">\n                        <label class=\"form-label\">\u6ce8\u518c\u90ae\u7bb1</label>\n                        <input id=\"email\" type=\"email\" class=\"form-control\">\n                    </div>\n                    <div class=\"mb-2\">\n                        <label class=\"form-label\">\n                            \u767b\u5f55\u5bc6\u7801\n                            <span class=\"form-label-description\">\n                                <a href=\"/password/reset\">\u5fd8\u8bb0\u5bc6\u7801</a>\n                            </span>\n                        </label>\n                        <div class=\"input-group input-group-flat\">\n                            <input id=\"passwd\" type=\"password\" class=\"form-control\" autocomplete=\"off\">\n                        </div>\n                    </div>\n                    <div class=\"mb-2\">\n                        <label class=\"form-label\">\u4e24\u6b65\u8ba4\u8bc1</label>\n                        <input id=\"code\" type=\"email\" class=\"form-control\" placeholder=\"\u5982\u679c\u6ca1\u6709\u8bbe\u7f6e\u4e24\u6b65\u8ba4\u8bc1\u53ef\u7559\u7a7a\">\n                    </div>\n                    <div class=\"mb-2\">\n                        <label class=\"form-check\">\n                            <input id=\"remember_me\" type=\"checkbox\" class=\"form-check-input\" />\n                            <span class=\"form-check-label\">\u8bb0\u4f4f\u6b64\u8bbe\u5907</span>\n                        </label>\n                    </div>\n                                        <div class=\"form-footer\">\n                        <button id=\"login-dashboard\" class=\"btn btn-primary w-100\">\u767b\u5f55</button>\n                    </div>\n                    <p class=\"text-center text-secondary mt-3\">\u5982\u679c\u767b\u5f55\u4e0d\u4e86\u8bf7\u4f7f\u7528Chrome\u6d4f\u89c8\u5668</p>\n                </div>\n            </div>\n            <div class=\"text-center text-secondary mt-3\">\n                \u8fd8\u6ca1\u6709\u8d26\u6237\uff1f <a href=\"/auth/register\" tabindex=\"-1\">\u70b9\u51fb\u6ce8\u518c</a>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        function showAuthModal(dialogId, fallbackMessage) {\n            const modalElement = document.getElementById(dialogId);\n            const modalApi = window.bootstrap || (window.tabler && window.tabler.bootstrap);\n\n            if (modalElement && modalApi && modalApi.Modal) {\n                modalApi.Modal.getOrCreateInstance(modalElement).show();\n                return;\n            }\n\n            window.alert(fallbackMessage);\n        }\n\n        $(\"#login-dashboard\").click(function() {\n            $.ajax({\n                type: 'POST',\n                url: '/auth/login',\n                dataType: \"json\",\n                data: {\n                    code: $('#code').val(),\n                    email: $('#email').val(),\n                    passwd: $('#passwd').val(),\n                    remember_me: $('#remember_me').is(\":checked\"),\n                                    },\n                success: function(data) {\n                    if (data.ret === 1) {\n                        $('#success-message').text(data.msg);\n                        const redir = data.redir || '/user';\n                        window.setTimeout(function() {\n                            window.location.href = redir;\n                        }, 1200);\n                        showAuthModal('success-dialog', data.msg);\n                    } else {\n                        $('#fail-message').text(data.msg);\n                        showAuthModal('fail-dialog', data.msg);\n                    }\n                },\n                error: function(xhr) {\n                    if (xhr.responseURL && new URL(xhr.responseURL).pathname.startsWith('/user')) {\n                        window.location.href = '/user';\n                        return;\n                    }\n                    const message = '\u767b\u5f55\u8bf7\u6c42\u5931\u8d25\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5';\n                    $('#fail-message').text(message);\n                    showAuthModal('fail-dialog', message);\n                }\n            })\n        });\n    </script>\n\n    \n<div class=\"modal modal-blur fade\" id=\"success-dialog\" tabindex=\"-1\" role=\"dialog\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-sm modal-dialog-centered\" role=\"document\">\n        <div class=\"modal-content\">\n            <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n            <div class=\"modal-status bg-success\"></div>\n            <div class=\"modal-body text-center py-4\">\n                <i class=\"ti ti-circle-check icon mb-2 text-green icon-lg\" style=\"font-size:3.5rem;\"></i>\n                <p id=\"success-message\" class=\"text-secondary\">\u6210\u529f</p>\n            </div>\n            <div class=\"modal-footer\">\n                <div class=\"w-100\">\n                    <div class=\"row\">\n                        <div class=\"col\">\n                            <a id=\"success-confirm\" href=\"\" class=\"btn w-100\" data-bs-dismiss=\"modal\">\n                                \u597d\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class=\"modal modal-blur fade\" id=\"fail-dialog\" tabindex=\"-1\" role=\"dialog\" aria-hidden=\"true\">\n    <div class=\"modal-dialog modal-sm modal-dialog-centered\" role=\"document\">\n        <div class=\"modal-content\">\n            <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n            <div class=\"modal-status bg-danger\"></div>\n            <div class=\"modal-body text-center py-4\">\n                <i class=\"ti ti-circle-x icon mb-2 text-danger icon-lg\" style=\"font-size:3.5rem;\"></i>\n                <p id=\"fail-message\" class=\"text-secondary\">\u5931\u8d25</p>\n            </div>\n            <div class=\"modal-footer\">\n                <div class=\"w-100\">\n                    <div class=\"row\">\n                        <div class=\"col\">\n                            <a href=\"\" class=\"btn btn-danger w-100\" data-bs-dismiss=\"modal\">\n                                \u786e\u8ba4\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script src=\"//testingcf.jsdelivr.net/npm/@tabler/core@latest/dist/js/tabler.min.js\"></script>\n\n\n    <script type=\"text/javascript\"> window.$crisp = [];\n        window.CRISP_WEBSITE_ID = \"906653c3-dc39-41db-8ce8-2ccc2917b184\";\n                (function () {\n            d = document;\n            s = d.createElement(\"script\");\n            s.src = \"https://client.crisp.chat/l.js\";\n            s.async = 1;\n            d.getElementsByTagName(\"head\")[0].appendChild(s);\n        })();\n        $crisp.push([\"safe\", true])\n        $crisp.push([\"set\", \"user:nickname\", \"\"],\n            [\"set\", \"user:email\", \"\"],\n            [\"set\", \"session:data\",\n                [[\n                    [\"user_id\", \"\"],\n                    [\"user_class\", \"\"],\n                    [\"node_group\", \"\"],\n                    [\"reg_email\", \"\"],\n                    [\"class_expire_time\", \"\"],\n                    [\"available_traffic\", \"0B\"],\n                    [\"balance\", \"\"]\n                ]]\n            ]);\n\n        $crisp.push([\"on\", \"session:loaded\", function (sessionId) {\n            fetch(\"/user/crisp/session\", {\n                method: \"POST\",\n                credentials: \"same-origin\",\n                headers: {\n                    \"Content-Type\": \"application/json\",\n                    \"X-Requested-With\": \"XMLHttpRequest\"\n                },\n                body: JSON.stringify({ session_id: sessionId })\n            }).catch(function () {\n                // \u4f1a\u8bdd\u5c06\u5728\u7528\u6237\u4e0b\u6b21\u6253\u5f00\u9875\u9762\u65f6\u91cd\u65b0\u7ed1\u5b9a\uff0c\u4e0d\u5f71\u54cd Crisp \u6b63\u5e38\u4f7f\u7528\n            });\n        }]);\n\n        document.addEventListener(\"click\", function (event) {\n            const logoutLink = event.target.closest('a[href=\"/user/logout\"]');\n            if (!logoutLink) {\n                return;\n            }\n\n            event.preventDefault();\n            window.CRISP_TOKEN_ID = null;\n            $crisp.push([\"do\", \"session:reset\"]);\n            window.setTimeout(function () {\n                window.location.href = logoutLink.href;\n            }, 100);\n        });\n    </script>\n\n\n\n</body>\n\n</html>"}
