ADMIN_TOKEN=replace-with-a-long-random-secret
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
POLL_MS=60000
OCR_PYTHON=
STANDALONE_POLL_MS=10000
STANDALONE_CONCURRENCY=2
# Optional private account map; never include this file in a public image.
CREDENTIALS_FILE=
# Independent measurements: separate DB, disabled in persisted control by default.
# Subscription/client state stays in the user's isolated local proxy client.
# Optional proxy auth is a private <opaque-secretRef>.json, never an inline URL.
MEASUREMENT_STORE_FILE=
MEASUREMENT_SECRET_DIR=
