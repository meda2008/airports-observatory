{
  "name": "airport-data-system",
  "version": "4.0.0",
  "description": "机场数据 API 系统 - 整合真实价格验证数据",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "collect:plan": "node scripts/collection.cjs plan",
    "collect:pipeline": "node scripts/collection-pipeline.cjs",
    "collect:report": "node scripts/collection.cjs report",
    "collect:validate": "node scripts/validate-collection.cjs",
    "dev": "node server.js",
    "test": "node --test tests/*.test.cjs",
    "test:public": "npm --prefix public-site test",
    "check:public": "npm --prefix public-site run check",
    "verify:online": "npm --prefix public-site run verify:online",
    "check": "node --check server.js && node --check lib/app.cjs && node --check lib/catalog-service.cjs && node --check web/app.js && node --check public-site/src/app.js && node public-site/scripts/validate-site.cjs"
  },
  "keywords": ["airports", "vpn", "data", "api"],
  "author": "Qoder",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
