# 公开同源前端与三服务反向代理加固配置模板
# 本地默认监听 :80；生产可通过环境变量 PUBLIC_WEB_HOST=airports.vigorai.top 自动启用 HTTPS
{$PUBLIC_WEB_HOST::80} {
    encode zstd gzip
    request_body {
        max_size 9MB
    }

    # 公开站严格拦截管理后台与内部 RPC 路径（大小写无关）
    @blocked path_regexp blocked (?i)^/(console|assistance|api/admin|internal)([/.].*)?$
    respond @blocked 404

    reverse_proxy {$WEB_UPSTREAM:web:8080} {
        header_up -oai-authenticated-user-id
        header_up -oai-authenticated-user-email
        header_up -X-Forwarded-User
        header_up -X-Remote-User
        header_up -Authorization
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

