# This allowlist applies only to builds using deploy-service/Dockerfile.
# Private deploy state, auth, measurement configs and validation logs never enter
# its build context. Runtime code must not contain embedded credentials.
**
!package.json
!scripts/
!scripts/export-current-inventory.cjs
!scripts/measurements.cjs
!scripts/local-product.cjs
!lib/
!lib/**
!catalog/
!catalog/*.json
!catalog/*.ndjson
!collection/
!collection/*.cjs
!collection/*.mjs
!collection/*.json
!collection/site-collectors/
!collection/site-collectors/*.json
!collection/site-contracts/
!collection/site-contracts/*.json
!collection/url-collectors/
!collection/url-collectors/**
!collection/website-collectors/
!collection/website-collectors/*.json
!collection/challenge.mjs
!collection/passive-browser-check.cjs
!collection/verification-actions.mjs
!collection/knowledge-browser.mjs
!collection/visible-document.mjs
!collection/standalone-auth-recovery.cjs
!collection/standalone-recovery-profiles.cjs
!collection/passive-access-wait.mjs
!collection/native-read-link.mjs
!collection/site-recipes/
!collection/site-recipes/*.mjs
!deploy-service/
!deploy-service/package.json
!deploy-service/package-lock.json
!deploy-service/*.cjs
!deploy-service/three-services/
!deploy-service/three-services/**
!deploy-service/measurement-sidecar/
!deploy-service/measurement-sidecar/local-healthcheck.cjs
!deploy-service/public/
!deploy-service/public/**
!deploy-service/ocr-runner.py
!deploy-service/requirements-ocr.txt
deploy-service/*credentials*
collection/*credentials*
collection/*secret*
