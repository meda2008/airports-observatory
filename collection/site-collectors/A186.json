{
  "schemaVersion": "airports-site-collector.v1",
  "recordId": "A186",
  "name": "FastLink",
  "entryUrl": "https://fastlink.ws/user/shop",
  "entrySource": "public-catalog.coreInfo.website",
  "allowedHosts": [
    "fastlink.ws"
  ],
  "adapter": "generic",
  "maxPages": 1,
  "enabled": true,
  "eligibility": "queued",
  "reason": "用户完成现存页面登录；只读留存业务区，不证明法律主体或连续经营。",
  "workflow": [
    "homepage",
    "auth",
    "register",
    "email",
    "plans",
    "payment",
    "refund",
    "review",
    "block"
  ],
  "refreshIntervalMs": 604800000,
  "fields": [
    "pricing"
  ],
  "policy": {
    "browser": "codex_builtin",
    "allowPayment": false,
    "allowPaidTrial": false,
    "allowProtectionBypass": false,
    "cloudflare": "checkpoint_and_backoff",
    "unpaidOrder": "explicit_existing_workflow_authorization_and_cleanup_required",
    "registration": "existing_authorization_required",
    "publication": "independent_review_required"
  },
  "collectPerformanceReferences": false,
  "auth": {
    "mode": "login",
    "discoverFromVisibleForm": true,
    "successSelector": "a[href=\"/user/shop\"]:visible"
  },
  "publicOnly": false,
  "accountReadOnly": true,
  "reconcileVerifiedCheckpoints": true
}
