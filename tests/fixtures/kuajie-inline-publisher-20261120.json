{"url":"https://qu01.kuajiecloud.com/","status":200,"observedAt":"2026-11-20T02:09:40.939Z","body":"<!doctype html>\n<html lang=\"zh-CN\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>线路检测</title>\n    <script>\n      const DOMAIN_LIST =\"xdxx.kuajiexx.cfd safds.kuajiexx.cfd hj235.kuajiexx.cfd ghj.kuajiexdx.online thyr.kuajiexdx.online 544fed.kuajiexdx.online\";\n    </script>\n    <style>\n      :root {\n        --bg0: #f8fbff;\n        --card: rgba(255, 255, 255, 0.86);\n        --card2: rgba(255, 255, 255, 0.62);\n        --text: #0f172a;\n        --muted: #64748b;\n        --border: rgba(148, 163, 184, 0.25);\n        --shadow: 0 18px 50px rgba(2, 6, 23, 0.08);\n        --shadow2: 0 10px 30px rgba(2, 6, 23, 0.06);\n        --green: #16a34a;\n        --red: #e11d48;\n        --orange: #f97316;\n        --accentA: #2563eb;\n        --accentB: #06b6d4;\n        --accentC: #22c55e;\n        --btn: linear-gradient(135deg, #2563eb 0%, #06b6d4 55%, #22c55e 100%);\n        --btnText: #ffffff;\n        --pill: rgba(2, 6, 23, 0.06);\n        --ring: rgba(37, 99, 235, 0.28);\n        --inputBg: rgba(255, 255, 255, 0.62);\n      }\n      :root[data-theme=\"dark\"] {\n        --bg0: #0b1220;\n        --card: rgba(15, 23, 42, 0.75);\n        --card2: rgba(2, 6, 23, 0.35);\n        --text: #e2e8f0;\n        --muted: #94a3b8;\n        --border: rgba(148, 163, 184, 0.22);\n        --shadow: 0 18px 50px rgba(0, 0, 0, 0.45);\n        --shadow2: 0 10px 30px rgba(0, 0, 0, 0.3);\n        --pill: rgba(255, 255, 255, 0.07);\n        --ring: rgba(37, 99, 235, 0.24);\n        --inputBg: rgba(2, 6, 23, 0.22);\n      }\n      * {\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        height: 100%;\n      }\n      body {\n        margin: 0;\n        font-family: ui-sans-serif, system-ui, -apple-system, \"PingFang SC\", \"Segoe UI\",\n          Roboto, Helvetica, Arial, \"Apple Color Emoji\", \"Segoe UI Emoji\";\n        color: var(--text);\n        background: radial-gradient(1200px 560px at 18% -10%, rgba(37, 99, 235, 0.16), transparent 62%),\n          radial-gradient(1150px 540px at 86% 14%, rgba(6, 182, 212, 0.14), transparent 60%),\n          radial-gradient(1200px 640px at 55% 110%, rgba(34, 197, 94, 0.12), transparent 58%),\n          var(--bg0);\n      }\n      a {\n        color: inherit;\n        text-decoration: none;\n      }\n      .container {\n        max-width: 1100px;\n        margin: 0 auto;\n        padding: 24px 18px 40px;\n      }\n      .top {\n        display: flex;\n        align-items: flex-start;\n        justify-content: space-between;\n        gap: 14px;\n        padding: 18px 18px 14px;\n        border: 1px solid var(--border);\n        border-radius: 16px;\n        background: linear-gradient(180deg, var(--card), var(--card2));\n        box-shadow: var(--shadow);\n        backdrop-filter: blur(10px);\n      }\n      .top h1 {\n        margin: 0;\n        font-size: 18px;\n        letter-spacing: 0.2px;\n      }\n      .top p {\n        margin: 10px 0 0;\n        font-size: 12px;\n        line-height: 1.6;\n        color: var(--muted);\n        max-width: 760px;\n      }\n      .actions {\n        display: flex;\n        gap: 10px;\n        align-items: center;\n      }\n      .chip {\n        border: 1px solid var(--border);\n        background: var(--pill);\n        border-radius: 999px;\n        padding: 8px 10px;\n        font-size: 12px;\n        color: var(--muted);\n        cursor: pointer;\n        user-select: none;\n      }\n      .chip:focus {\n        outline: none;\n        box-shadow: 0 0 0 4px var(--ring);\n      }\n      .section {\n        margin-top: 14px;\n        padding: 18px;\n        border-radius: 18px;\n        border: 1px solid var(--border);\n        background: linear-gradient(180deg, var(--card), var(--card2));\n        box-shadow: var(--shadow2);\n        backdrop-filter: blur(10px);\n      }\n      .row {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 14px;\n      }\n      .title {\n        font-size: 14px;\n        font-weight: 700;\n        margin: 0;\n      }\n      .sub {\n        font-size: 12px;\n        color: var(--muted);\n        margin-top: 8px;\n      }\n      .recommend {\n        display: grid;\n        grid-template-columns: 1fr auto;\n        gap: 12px;\n        align-items: center;\n      }\n      .rec-left .host {\n        font-size: 20px;\n        font-weight: 800;\n        margin-top: 8px;\n        letter-spacing: 0.2px;\n      }\n      .rec-left .meta {\n        margin-top: 6px;\n        font-size: 12px;\n        color: var(--muted);\n        display: flex;\n        gap: 10px;\n        flex-wrap: wrap;\n      }\n      .badge {\n        display: inline-flex;\n        align-items: center;\n        gap: 6px;\n        padding: 4px 10px;\n        border-radius: 999px;\n        background: var(--pill);\n        border: 1px solid var(--border);\n        color: var(--muted);\n      }\n      .badge.badge-countdown {\n        padding: 6px 12px;\n        font-size: 13px;\n        font-weight: 900;\n        color: #fff;\n        border: 0;\n        background: linear-gradient(135deg, #f97316 0%, #e11d48 100%);\n        box-shadow: 0 14px 30px rgba(249, 115, 22, 0.22);\n      }\n      .badge.badge-countdown.is-running {\n        animation: ntPulse 1s ease-in-out infinite;\n      }\n      @keyframes ntPulse {\n        0%,\n        100% {\n          transform: scale(1);\n          filter: brightness(1);\n        }\n        50% {\n          transform: scale(1.035);\n          filter: brightness(1.06);\n        }\n      }\n      .btn {\n        background: var(--btn);\n        border: none;\n        color: var(--btnText);\n        padding: 10px 16px;\n        border-radius: 999px;\n        font-weight: 700;\n        cursor: pointer;\n        box-shadow: 0 12px 26px rgba(59, 130, 246, 0.18);\n      }\n      .btn:disabled {\n        opacity: 0.55;\n        cursor: not-allowed;\n      }\n      .btn.secondary {\n        background: transparent;\n        color: var(--text);\n        border: 1px solid var(--border);\n        box-shadow: none;\n      }\n      .btn:focus {\n        outline: none;\n        box-shadow: 0 0 0 4px var(--ring);\n      }\n      .table-wrap {\n        margin-top: 10px;\n        border-radius: 14px;\n        overflow: hidden;\n        border: 1px solid var(--border);\n        background: rgba(255, 255, 255, 0.55);\n      }\n      :root[data-theme=\"dark\"] .table-wrap {\n        background: rgba(2, 6, 23, 0.25);\n      }\n      table {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 13px;\n      }\n      thead th {\n        text-align: left;\n        padding: 12px 14px;\n        color: var(--muted);\n        font-weight: 700;\n        background: rgba(2, 6, 23, 0.03);\n      }\n      :root[data-theme=\"dark\"] thead th {\n        background: rgba(255, 255, 255, 0.04);\n      }\n      tbody td {\n        padding: 12px 14px;\n        border-top: 1px solid var(--border);\n        vertical-align: middle;\n      }\n      .url {\n        font-weight: 700;\n      }\n      .small {\n        display: block;\n        margin-top: 4px;\n        font-weight: 500;\n        font-size: 12px;\n        color: var(--muted);\n        word-break: break-all;\n      }\n      .status-ok {\n        color: var(--green);\n        font-weight: 800;\n      }\n      .status-bad {\n        color: var(--red);\n        font-weight: 800;\n      }\n      .lat-ok {\n        color: var(--orange);\n        font-weight: 800;\n      }\n      .lat-bad {\n        color: var(--red);\n        font-weight: 800;\n      }\n      .op {\n        text-align: right;\n      }\n      .row-right {\n        margin-left: auto;\n        display: flex;\n        align-items: center;\n        gap: 10px;\n      }\n      .pill-right {\n        font-size: 12px;\n        color: var(--muted);\n        padding: 6px 10px;\n        border-radius: 999px;\n        border: 1px solid var(--border);\n        background: var(--pill);\n      }\n      .foot {\n        margin-top: 10px;\n        font-size: 12px;\n        color: var(--muted);\n      }\n      .btn.small {\n        padding: 9px 12px;\n        font-weight: 750;\n      }\n      @media (max-width: 860px) {\n        .container {\n          padding: 18px 14px 28px;\n        }\n        .recommend {\n          grid-template-columns: 1fr;\n        }\n        .op {\n          text-align: left;\n        }\n        .row {\n          flex-direction: column;\n          align-items: flex-start;\n        }\n        .actions {\n          width: 100%;\n          flex-wrap: wrap;\n        }\n        .actions .btn,\n        .actions .chip {\n          width: 100%;\n          justify-content: center;\n        }\n      }\n      @media (max-width: 720px) {\n        thead {\n          display: none;\n        }\n        .table-wrap {\n          background: transparent;\n          border: none;\n          overflow: visible;\n        }\n        table,\n        tbody,\n        tr {\n          display: block;\n          width: 100%;\n        }\n        tbody tr {\n          margin-top: 10px;\n          border-radius: 16px;\n          border: 1px solid var(--border);\n          background: linear-gradient(180deg, var(--card), var(--card2));\n          box-shadow: var(--shadow2);\n          backdrop-filter: blur(10px);\n          overflow: hidden;\n        }\n        tbody td {\n          display: flex;\n          gap: 10px;\n          align-items: flex-start;\n          justify-content: space-between;\n          border-top: 1px solid var(--border);\n        }\n        tbody td:first-child {\n          border-top: none;\n        }\n        tbody td::before {\n          content: attr(data-label);\n          color: var(--muted);\n          font-weight: 750;\n          flex: 0 0 auto;\n        }\n        .op {\n          text-align: left;\n        }\n      }\n    </style>\n  </head>\n  <body>\n    <div class=\"container\">\n      <div class=\"top\">\n        <div>\n          <h1>线路检测</h1>\n          <p>\n            目标网址检测将在本页面内自动完成：自动选择最快可用目标展示到推荐区，其余目标按结果与延迟展示在列表中。\n            <br />\n          </p>\n        </div>\n        <div class=\"actions\">\n          <button id=\"btnTheme\" class=\"chip\" type=\"button\">暗色</button>\n        </div>\n      </div>\n\n      <div class=\"section\">\n        <div class=\"recommend\">\n          <div class=\"rec-left\">\n            <div class=\"title\">推荐目标</div>\n            <div id=\"recHost\" class=\"host\">检测中…</div>\n            <div class=\"meta\">\n              <span id=\"recLatency\" class=\"badge\">延迟 -</span>\n              <span id=\"recStatus\" class=\"badge\">状态 -</span>\n              <span id=\"recCountdown\" class=\"badge badge-countdown\" style=\"display: none\">自动跳转 -</span>\n            </div>\n          </div>\n          <div class=\"actions\">\n            <button id=\"btnRetest\" class=\"btn secondary\" type=\"button\">重新检测</button>\n            <button id=\"btnVisitBest\" class=\"btn\" type=\"button\" disabled>访问</button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"section\">\n        <div class=\"row\">\n          <div>\n            <div class=\"title\">检测目标网址</div>\n          </div>\n          <div class=\"row-right\">\n            <div id=\"countPill\" class=\"pill-right\">共 0 个</div>\n            <button id=\"btnToggleList\" class=\"btn secondary small\" type=\"button\">显示更多</button>\n          </div>\n        </div>\n        <div class=\"table-wrap\">\n          <table>\n            <thead>\n              <tr>\n                <th style=\"width: 52%\">目标网址</th>\n                <th style=\"width: 14%\">状态</th>\n                <th style=\"width: 14%\">延迟</th>\n                <th style=\"width: 20%; text-align: right\">操作</th>\n              </tr>\n            </thead>\n            <tbody id=\"tbody\"></tbody>\n          </table>\n        </div>\n        <div class=\"foot\" id=\"footNote\"></div>\n      </div>\n    </div>\n\n    <script>\n      const CONFIG = {\n        timeoutMs: 4500,\n        concurrency: 3,\n        targets: [\n          { name: \"fast-v1.example.com\", url: \"https://fast-v1.example.com\" },\n          { name: \"fast-v2.example.com\", url: \"https://fast-v2.example.com\" },\n          { name: \"fast-v3.example.com\", url: \"https://fast-v3.example.com\" },\n          { name: \"www.example.com\", url: \"https://www.example.com\" }\n        ]\n      };\n\n      const els = {\n        recHost: document.getElementById(\"recHost\"),\n        recLatency: document.getElementById(\"recLatency\"),\n        recStatus: document.getElementById(\"recStatus\"),\n        recCountdown: document.getElementById(\"recCountdown\"),\n        tbody: document.getElementById(\"tbody\"),\n        btnVisitBest: document.getElementById(\"btnVisitBest\"),\n        btnRetest: document.getElementById(\"btnRetest\"),\n        btnTheme: document.getElementById(\"btnTheme\"),\n        countPill: document.getElementById(\"countPill\"),\n        btnToggleList: document.getElementById(\"btnToggleList\"),\n        footNote: document.getElementById(\"footNote\")\n      };\n\n      const THEME_KEY = \"nt_jump_theme\";\n      const DEFAULT_VISIBLE = 5;\n      const AUTO_JUMP_SECONDS = 2;\n\n      function setTheme(theme) {\n        document.documentElement.dataset.theme = theme;\n        localStorage.setItem(THEME_KEY, theme);\n        els.btnTheme.textContent = theme === \"dark\" ? \"亮色\" : \"暗色\";\n      }\n\n      function initTheme() {\n        const saved = localStorage.getItem(THEME_KEY);\n        if (saved === \"dark\" || saved === \"light\") return setTheme(saved);\n        const prefersDark = window.matchMedia && window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\n        setTheme(prefersDark ? \"dark\" : \"light\");\n      }\n\n      function safeUrl(raw) {\n        try {\n          const u = new URL(raw);\n          return u.toString().replace(/\\/$/, \"\");\n        } catch {\n          return raw;\n        }\n      }\n\n      function hostFromUrl(raw) {\n        try {\n          return new URL(raw).host;\n        } catch {\n          return raw;\n        }\n      }\n\n      function getTargets() {\n        const raw = String(typeof DOMAIN_LIST === \"string\" ? DOMAIN_LIST : \"\").trim();\n        const tokens = raw ? raw.split(/\\s+/).filter(Boolean) : [];\n        const items = tokens\n          .map((t) => {\n            const s = String(t || \"\").trim();\n            if (!s) return null;\n            if (/^https?:\\/\\//i.test(s)) {\n              return { name: hostFromUrl(s), url: s, altUrl: null };\n            }\n            return { name: s, url: \"https://\" + s, altUrl: \"http://\" + s };\n          })\n          .filter(Boolean);\n        if (items.length) return items;\n        return CONFIG.targets.map((t) => ({ name: t.name || hostFromUrl(t.url), url: t.url }));\n      }\n\n      function getCode() {\n        const s = new URLSearchParams(location.search).get(\"code\");\n        if (s) return s;\n        if (location.hash) {\n          const h = location.hash.replace(/^#/, \"\");\n          const q = h.includes(\"?\") ? h.split(\"?\")[1] : h;\n          if (q) {\n            const v = new URLSearchParams(q).get(\"code\");\n            if (v) return v;\n          }\n        }\n        return null;\n      }\n\n      function buildVisitUrl(rawUrl) {\n        const code = getCode();\n        try {\n          const u = new URL(rawUrl);\n          if (code) u.searchParams.set(\"code\", code);\n          return u.toString();\n        } catch {\n          if (!code) return rawUrl;\n          return rawUrl + (rawUrl.includes(\"?\") ? \"&\" : \"?\") + \"code=\" + encodeURIComponent(code);\n        }\n      }\n\n      function sleep(ms) {\n        return new Promise((r) => setTimeout(r, ms));\n      }\n\n      function buildProbeUrl(rawUrl) {\n        try {\n          const u = new URL(rawUrl);\n          return u.origin + \"/favicon.ico?t=\" + Date.now() + \"_\" + Math.random().toString(16).slice(2);\n        } catch {\n          const base = String(rawUrl || \"\").replace(/\\/+$/, \"\");\n          const sep = base.includes(\"?\") ? \"&\" : \"?\";\n          return base + sep + \"t=\" + Date.now() + \"_\" + Math.random().toString(16).slice(2);\n        }\n      }\n\n      function probeUrl(rawUrl, timeoutMs) {\n        const url = safeUrl(rawUrl);\n        const t0 = performance.now();\n        const probe = buildProbeUrl(url);\n        return new Promise((resolve) => {\n          let done = false;\n          const img = new Image();\n          const timer = setTimeout(() => {\n            if (done) return;\n            done = true;\n            img.onload = null;\n            img.onerror = null;\n            resolve({ ok: false, latencyMs: null, reason: \"超时\" });\n          }, timeoutMs);\n\n          const finishOk = () => {\n            if (done) return;\n            done = true;\n            clearTimeout(timer);\n            img.onload = null;\n            img.onerror = null;\n            const ms = Math.max(0, Math.round(performance.now() - t0));\n            resolve({ ok: true, latencyMs: ms, reason: null });\n          };\n\n          img.onload = finishOk;\n          img.onerror = finishOk;\n          img.referrerPolicy = \"no-referrer\";\n          img.decoding = \"async\";\n          img.src = probe;\n        });\n      }\n\n      function probeTarget(t, timeoutMs) {\n        if (!t.altUrl) {\n          return probeUrl(t.url, timeoutMs).then((r) => ({ ...r, url: t.url }));\n        }\n        return new Promise((resolve) => {\n          let settled = false;\n          let finished = 0;\n          let lastFail = null;\n\n          const handle = (candidateUrl) => (r) => {\n            if (settled) return;\n            finished += 1;\n            if (r.ok) {\n              settled = true;\n              resolve({ ok: true, latencyMs: r.latencyMs, reason: null, url: candidateUrl });\n              return;\n            }\n            lastFail = r;\n            if (finished >= 2) {\n              resolve({\n                ok: false,\n                latencyMs: null,\n                reason: (lastFail && lastFail.reason) || \"不可用\",\n                url: t.url\n              });\n            }\n          };\n\n          probeUrl(t.url, timeoutMs).then(handle(t.url));\n          probeUrl(t.altUrl, timeoutMs).then(handle(t.altUrl));\n        });\n      }\n\n      async function runPoolProgress(items, worker, concurrency, onItem) {\n        const results = new Array(items.length);\n        let nextIndex = 0;\n\n        async function runner() {\n          while (true) {\n            const i = nextIndex++;\n            if (i >= items.length) break;\n            results[i] = await worker(items[i], i);\n            if (onItem) onItem(results[i], i);\n          }\n        }\n\n        const runners = Array.from({ length: Math.min(concurrency, items.length) }, runner);\n        await Promise.all(runners);\n        return results;\n      }\n\n      function sortRows(rows) {\n        const copied = rows.slice();\n        copied.sort((a, b) => {\n          if (a.ok !== b.ok) return a.ok ? -1 : 1;\n          if (a.ok && b.ok) return (a.latencyMs || 0) - (b.latencyMs || 0);\n          return a.name.localeCompare(b.name);\n        });\n        return copied;\n      }\n\n      function renderTable(rows, bestUrl) {\n        els.tbody.innerHTML = \"\";\n        for (const r of rows) {\n          const tr = document.createElement(\"tr\");\n          const tdUrl = document.createElement(\"td\");\n          const tdStatus = document.createElement(\"td\");\n          const tdLat = document.createElement(\"td\");\n          const tdOp = document.createElement(\"td\");\n          tdOp.className = \"op\";\n          tdUrl.dataset.label = \"目标网址\";\n          tdStatus.dataset.label = \"状态\";\n          tdLat.dataset.label = \"延迟\";\n          tdOp.dataset.label = \"操作\";\n\n          const isBest = bestUrl && safeUrl(r.url) === safeUrl(bestUrl) && r.ok;\n\n          tdUrl.innerHTML =\n            '<span class=\"url\">' +\n            (r.name || hostFromUrl(r.url)) +\n            (isBest ? ' <span class=\"badge\">最优</span>' : \"\") +\n            '</span><span class=\"small\">' +\n            safeUrl(r.url) +\n            \"</span>\";\n\n          tdStatus.innerHTML = r.ok\n            ? '<span class=\"status-ok\">可用</span>'\n            : '<span class=\"status-bad\">不可用</span>';\n\n          if (r.ok) {\n            const c = r.latencyMs <= 1200 ? \"lat-ok\" : \"lat-bad\";\n            tdLat.innerHTML = '<span class=\"' + c + '\">' + r.latencyMs + \"ms</span>\";\n          } else {\n            tdLat.innerHTML = '<span class=\"lat-bad\">' + (r.reason || \"超时\") + \"</span>\";\n          }\n\n          if (r.ok) {\n            const btn = document.createElement(\"button\");\n            btn.className = \"btn\";\n            btn.type = \"button\";\n            btn.textContent = \"访问\";\n            btn.addEventListener(\"click\", () => {\n              window.location.href = buildVisitUrl(safeUrl(r.url));\n            });\n            tdOp.appendChild(btn);\n          } else {\n            tdOp.textContent = \"\";\n          }\n\n          tr.appendChild(tdUrl);\n          tr.appendChild(tdStatus);\n          tr.appendChild(tdLat);\n          tr.appendChild(tdOp);\n          els.tbody.appendChild(tr);\n        }\n      }\n\n      function renderRecommend(best) {\n        if (!best) {\n          els.recHost.textContent = \"暂无可用目标\";\n          els.recLatency.textContent = \"延迟 -\";\n          els.recStatus.textContent = \"状态 不可用\";\n          stopAutoJump();\n          els.btnVisitBest.disabled = true;\n          return;\n        }\n        els.recHost.textContent = best.name || hostFromUrl(best.url);\n        els.recLatency.textContent = \"延迟 \" + best.latencyMs + \"ms\";\n        els.recStatus.textContent = \"状态 可用\";\n        els.btnVisitBest.disabled = false;\n        els.btnVisitBest.onclick = () => {\n          stopAutoJump();\n          window.location.href = buildVisitUrl(safeUrl(best.url));\n        };\n        startAutoJump(best.url);\n      }\n\n      let autoJumpTimer = null;\n      let autoJumpDeadline = 0;\n      let autoJumpUrl = null;\n\n      function updateAutoJumpBadge(leftSeconds) {\n        els.recCountdown.style.display = \"\";\n        els.recCountdown.classList.add(\"is-running\");\n        els.recCountdown.textContent = leftSeconds + \"s 后自动跳转\";\n      }\n\n      function stopAutoJump() {\n        autoJumpUrl = null;\n        autoJumpDeadline = 0;\n        if (autoJumpTimer) {\n          clearInterval(autoJumpTimer);\n          autoJumpTimer = null;\n        }\n        els.recCountdown.classList.remove(\"is-running\");\n        els.recCountdown.style.display = \"none\";\n        els.recCountdown.textContent = \"自动跳转 -\";\n      }\n\n      function startAutoJump(url) {\n        autoJumpUrl = url;\n        if (autoJumpTimer) return;\n        autoJumpDeadline = Date.now() + AUTO_JUMP_SECONDS * 1000;\n        updateAutoJumpBadge(AUTO_JUMP_SECONDS);\n        autoJumpTimer = setInterval(() => {\n          if (!autoJumpDeadline || !autoJumpUrl) return;\n          const leftMs = autoJumpDeadline - Date.now();\n          const leftSeconds = Math.max(0, Math.ceil(leftMs / 1000));\n          updateAutoJumpBadge(leftSeconds);\n          if (leftMs <= 0) {\n            const to = autoJumpUrl;\n            stopAutoJump();\n            window.location.href = buildVisitUrl(safeUrl(to));\n          }\n        }, 200);\n      }\n\n      let showAll = false;\n      let lastRows = [];\n      let lastBestUrl = null;\n      let progressDone = 0;\n      let progressTotal = 0;\n      let renderScheduled = false;\n\n      function updateCountAndToggle(total) {\n        const prefix = running ? \"检测中 \" + progressDone + \"/\" + progressTotal + \" · \" : \"\";\n        if (total <= DEFAULT_VISIBLE) {\n          els.countPill.textContent = prefix + \"共 \" + total + \" 个\";\n          els.btnToggleList.style.display = \"none\";\n          return;\n        }\n        els.btnToggleList.style.display = \"\";\n        const shown = showAll ? total : DEFAULT_VISIBLE;\n        els.countPill.textContent = prefix + \"显示 \" + shown + \"/共 \" + total;\n        els.btnToggleList.textContent = showAll ? \"收起\" : \"显示更多\";\n      }\n\n      function scheduleRender() {\n        if (renderScheduled) return;\n        renderScheduled = true;\n        requestAnimationFrame(() => {\n          renderScheduled = false;\n          updateListView();\n        });\n      }\n\n      function updateListView() {\n        const total = lastRows.length;\n        updateCountAndToggle(total);\n        const visible = showAll ? lastRows : lastRows.slice(0, DEFAULT_VISIBLE);\n        renderTable(visible, lastBestUrl);\n      }\n\n      function renderFoot(rows, timeoutMs) {\n        const okCount = rows.filter((r) => r.ok).length;\n        const badCount = rows.length - okCount;\n        const code = getCode();\n        els.footNote.textContent =\n          \"检测方式：浏览器侧图片探测（favicon），超时 \" +\n          timeoutMs +\n          \"ms；结果受网络、DNS、浏览器策略影响。可用 \" +\n          okCount +\n          \"，不可用 \" +\n          badCount +\n          (code ? \"。访问将透传 code 参数。\" : \"。\");\n      }\n\n      let running = false;\n\n      async function runDetection() {\n        if (running) return;\n        running = true;\n        stopAutoJump();\n        els.btnRetest.disabled = true;\n        els.btnVisitBest.disabled = true;\n        els.btnToggleList.disabled = true;\n        showAll = false;\n        progressDone = 0;\n\n        els.recHost.textContent = \"检测中…\";\n        els.recLatency.textContent = \"延迟 -\";\n        els.recStatus.textContent = \"状态 -\";\n\n        const targets = getTargets();\n        progressTotal = targets.length;\n\n        lastBestUrl = null;\n        lastRows = targets.map((t) => ({ ...t, ok: false, latencyMs: null, reason: \"检测中\" }));\n        updateListView();\n\n        await sleep(30);\n\n        let best = null;\n\n        await runPoolProgress(\n          targets,\n          async (t) => {\n            const res = await probeTarget(t, CONFIG.timeoutMs);\n            return { ...t, ...res };\n          },\n          CONFIG.concurrency\n          ,\n          (row, i) => {\n            progressDone += 1;\n            lastRows[i] = { ...lastRows[i], ...row };\n            if (row.ok && (!best || (row.latencyMs || 0) < (best.latencyMs || 0))) {\n              best = lastRows[i];\n              lastBestUrl = best.url;\n              renderRecommend(best);\n            }\n            scheduleRender();\n          }\n        );\n\n        const sorted = sortRows(lastRows);\n        lastRows = sorted;\n        best = sorted.find((r) => r.ok) || null;\n        lastBestUrl = best ? best.url : null;\n        renderRecommend(best);\n        updateListView();\n        renderFoot(sorted, CONFIG.timeoutMs);\n\n        els.btnRetest.disabled = false;\n        els.btnToggleList.disabled = false;\n        running = false;\n      }\n\n      function bindEvents() {\n        els.btnTheme.addEventListener(\"click\", () => {\n          const current = document.documentElement.dataset.theme === \"dark\" ? \"dark\" : \"light\";\n          setTheme(current === \"dark\" ? \"light\" : \"dark\");\n        });\n        els.btnRetest.addEventListener(\"click\", () => runDetection());\n        els.btnToggleList.addEventListener(\"click\", () => {\n          showAll = !showAll;\n          updateListView();\n        });\n      }\n\n      initTheme();\n      bindEvents();\n      runDetection();\n    </script>\n  </body>\n</html>\n","sha256":"09bdebf3c428cfd7f47f8a3242ece3d1f9b41ba7155806fecfd9fb72c7330610"}
