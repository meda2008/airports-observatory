程列ARM V8 64位0.5.5、ARM V7 384/386版20240522（标太老不推荐）、ARM V7 AX32版0.5.5，并列不同Asus/网件等型号；不能把ARM64包用于ARMv7或推定未列型号兼容。","OpenClash教程要求Fake-IP/Meta内核（新版可无此选项），并建议禁用QUIC、禁止Dnsmasq缓存和不使用订阅转换。这是该站配置建议，未执行或独立验证对安全/性能的影响。","Passwall2只推荐明确需求的进阶用户，要求最新版及特定订阅格式；没有复制私人订阅、下载安装或执行命令。","正文中显示https://github.com/vernesong/OpenClash的链接实际指向https://t.me/merlinclashfile，文字与目标不一致；未打开Telegram或下载。另有正确指向GitHub wiki的独立文档链接，不能替错误链接背书。","教程自标2025-12-20更新包版本，目录为2025-12-24；均属当前页面日期标签，不是已核验的历史快照、成立证据或本轮测速。","iOS正文有外区App Store及共享账号建议，包含“不要升级/切勿开启双重认证”的说明；只保存作为站方教程风险，不执行账号切换、购买账号或弱化认证，也不推荐照做。","教程未写Shadowrocket最低版本，仅称最新版；Quantumult X/Surge限制针对站方所谓最新hy协议，不扩成全部产品或所有协议不兼容。"],"sourceIds":["CORE-AUTH-LIYU-B60-DOCUMENTS","CORE-AUTH-LIYU-B60-PLANS","CORE-AUTH-LIYU-B204-ROUTER","CORE-AUTH-LIYU-B204-IOS"]},"trial":{"status":"not_confirmed","observedAt":null,"summary":null,"conditions":[],"sourceIds":[],"executionVerified":false},"promotions":[],"speed":{"limitation":"实测只适用于列出的时间、网络、地区和样本；宣传上限及历史陈述不作为实测。","videoReports":[{"snapshotDisplayedAt":"2023-12-02T12:29:59+08:00","snapshotDisplayedDate":"2023-12-02","snapshotDisplayedClockLiteral":"Sat Dec 02 2023 12:29:59 GMT+0800 (中国标准时间)","snapshotClockAuthenticityVerified":false,"dateSemantics":"date_visible_in_player_image_not_throughput_test_date","throughputTestedAt":null,"sourceWasRecaptured":false,"legalEntityContinuityVerified":false,"sourceOriginalObservedAt":"2026-11-12T12:27:59.987Z","rateUnit":null,"aggregateValue":null,"eligibleForSpeedRanking":false,"currentOfficialUrlAtReview":"https://www.xiaoliyu.me/","dependencyGroup":"publisher:kerrynotes.com","currentOfficialHostname":"www.xiaoliyu.me","historicalIdentityVerified":false,"current":false,"accessBandwidth":null,"probeLocation":null,"videoSnapshotCount":1,"imageAuthenticityVerified":false,"rawMeasurementLogsVerified":false,"currentSpeedVerified":false,"imageLinkBasis":"native_full_image_anchor_selected_download","imageLinkLocator":{"kind":"capture_metadata"},"id":"round25-playback-A201-2023-12-02","metric"